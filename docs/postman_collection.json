{
  "info": {
    "name": "Library Management API",
    "description": "Requests for the Library Management System backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Patron\",\n  \"email\": \"patron@example.com\",\n  \"password\": \"StrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"StrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/1"
          }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/genres/1"
          }
        },
        {
          "name": "Delete genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/1"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List/search/paginate books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId=1&search=history&page=1&limit=10",
            "header": []
          }
        },
        {
          "name": "Get book",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/1",
            "header": []
          }
        },
        {
          "name": "Create book (Librarian)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/books",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Update book (Librarian)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/books/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Delete book (Librarian)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/books/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
