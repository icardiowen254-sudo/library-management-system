{
  "info": {
    "name": "Library Management API",
    "description": "Requests for the Library Management System backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Patron\",\n  \"email\": \"patron@example.com\",\n  \"password\": \"StrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"StrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/genres",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Biography\",\n  \"slug\": \"biography\",\n  \"description\": \"Life stories and biographies\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/genres/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated genre description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List/search/paginate books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId=1&search=history&page=1&limit=10",
            "header": []
          }
        },
        {
          "name": "Get book",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/1",
            "header": []
          }
        },
        {
          "name": "Create book (Librarian)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/books",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Example Book\",\n  \"author\": \"A. Writer\",\n  \"isbn\": \"9780000000001\",\n  \"totalCopies\": 5,\n  \"genreId\": 1,\n  \"description\": \"An example book record\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update book (Librarian)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/books/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete book (Librarian)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/books/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "PASTE_PATRON_OR_USER_TOKEN"
    },
    {
      "key": "librarianToken",
      "value": "PASTE_LIBRARIAN_TOKEN"
    }
  ]
}
